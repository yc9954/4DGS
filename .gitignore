# 4D Gaussian Splatting Pipeline - Git Ignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.spyderproject
.spyproject

# Jupyter
.ipynb_checkpoints
*.ipynb

# Testing
.coverage
htmlcov/
.tox/
.pytest_cache/
.mypy_cache/

# ============================================================================
# Data directories - Keep structure, ignore large files
# ============================================================================
# Keep directory structure with .gitkeep
data/inputs/*
!data/inputs/.gitkeep

data/processed/*
!data/processed/.gitkeep

data/outputs/*
!data/outputs/.gitkeep

# ============================================================================
# Large binary files (ignored everywhere)
# ============================================================================
# COLMAP database files
*.db
*.db-journal

# 3D model files
*.ply
*.pth
*.pt
*.ckpt

# Video files
*.mp4
*.avi
*.mov
*.webm
*.mkv

# ============================================================================
# Logs
# ============================================================================
logs/*
!logs/.gitkeep
*.log

# ============================================================================
# Pipeline state (resume data)
# ============================================================================
.pipeline_state/

# ============================================================================
# OS files
# ============================================================================
.DS_Store
Thumbs.db

# Temporary files
tmp/
temp/
*.tmp

# Secrets and config overrides
.env
*.local.yaml
secrets.yaml
